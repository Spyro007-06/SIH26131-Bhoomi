# ---------------------------------------------------------------------------
# Bhoomi v2 — environment template. Copy to .env and adjust.
# Every value here is read by app/config.py. Nothing else reads os.environ.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. asyncpg driver, not psycopg.
DATABASE_URL=postgresql+asyncpg://bhoomi:bhoomi@localhost:5432/bhoomi
# Alembic runs sync; same database, sync driver.
ALEMBIC_DATABASE_URL=postgresql+psycopg://bhoomi:bhoomi@localhost:5432/bhoomi

# --- Object storage (MinIO / any S3) ----------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=bhoomi
S3_SECRET_KEY=bhoomi123
S3_BUCKET=bhoomi-assets
S3_REGION=us-east-1
PRESIGN_EXPIRY_SECONDS=600

# --- Auth -------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_SECONDS=300

# Local only, and only when APP_ENV=local. Leave unset to always generate.
DEV_FIXED_OTP=000000

# --- Feature flags (docs/DESIGN.md §12) -------------------------------------
# VISION_MODEL=stub forces is_stub=true on every TopK. Clients must show a banner.
VISION_MODEL=stub
ASR_PROVIDER=stub
LLM_ENABLED=false

# --- Weather (F5) -----------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
