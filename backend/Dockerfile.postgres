# postgis/postgis:16-3.4 gives us PostGIS on Postgres 16. pgvector is not in that
# image, so add it here rather than asking six people to install it by hand.
FROM postgis/postgis:16-3.4

RUN apt-get update \
 && apt-get install -y --no-install-recommends postgresql-16-pgvector \
 && rm -rf /var/lib/apt/lists/*
